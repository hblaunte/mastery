# Copy to .env. Everything here is optional.

# Where Mastery keeps your sources, courses, sessions and (encrypted) key. Default: ./data
# MASTERY_DATA_DIR=./data

# Server port. Default: 8787
# MASTERY_PORT=8787

# A managed key: when set, the "Use a managed key" option becomes available in
# Settings → API key. The key never reaches the browser.
# MASTERY_MANAGED_KEY=sk-ant-...

# Grading and generation routes. Jobs are not equally hard, so they do not all
# get the same model. Setting MASTERY_MODEL alone puts the strong tier everywhere.
# MASTERY_MODEL=claude-opus-5-5          # strong tier: essay, experiment, course outline, item writing
# MASTERY_MODEL_CHEAP=claude-sonnet-5-5  # cheap tier: recall, calibration report
# MASTERY_EFFORT_ESSAY=high
# MASTERY_EFFORT_RECALL=medium

# Knowledge graph: a node lights up once an item's latest score reaches this.
# See docs/graph-threshold.md for why 75.
# MASTERY_GRAPH_THRESHOLD=75

# Set by the desktop shell; useful when embedding the server elsewhere.
# MASTERY_HOST=127.0.0.1          # bind address
# MASTERY_PORT=0                  # 0 = let the OS pick a free port
# MASTERY_TOKEN=                  # when set, every /api request must send it as x-mastery-token
# MASTERY_PROMPTS_DIR=prompts     # editable prompts live here
# MASTERY_WEB_DIST=apps/web/dist  # the built web app to serve on the same origin
