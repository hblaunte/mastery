{
  "name": "mastery",
  "private": true,
  "version": "0.1.0",
  "description": "Build your own course from your own sources, then be quizzed on it until you have mastered it.",
  "type": "module",
  "scripts": {
    "dev": "pnpm -r --parallel --filter ./apps/* dev",
    "build": "pnpm -r --filter ./packages/* --filter @mastery/web --filter @mastery/server build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "start": "pnpm --filter @mastery/server start",
    "desktop:dev": "pnpm --filter @mastery/desktop dev",
    "desktop:dist": "pnpm --filter @mastery/desktop dist"
  },
  "devDependencies": {
    "typescript": "^5.7.0"
  },
  "packageManager": "pnpm@11.12.0"
}
